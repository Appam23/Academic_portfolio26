---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Projects | Leihaopam Leisan">

    <link slot="head" rel="stylesheet" href="/project.css" />

    <a class="button button-outline back-home" href="/">
    ← Back to Home
    </a>

    <div class="projects-layout">
    <div class="personal-work">

 <section class="home-section" id="tangkhul-culture">
    <p class="eyebrow">WEB DEVELOPMENT · CULTURAL HERITAGE</p>
    <h1>Tangkhul Culture Website</h1>

    <img
        class="culture-image"
        src="/tangkhul-meadow.png"
        alt="A green meadow with a broad tree"
    />

    <p>
        A website sharing Tangkhul language, traditions, food,
        music, celebrations, and natural heritage.
    </p>
</section>
    
        <h2>My Projects</h2>

 <article id="projects" class="project-card">

    <h2>Personal Portfolio Website</h2>

    <p>
        This project demonstrates my web design
        and development skills.
    </p>

    <a
        class="text-link"
        href="https://leisanportfolio.netlify.app/"
        target="_blank"
        rel="noopener noreferrer"
    >
        Visit My Portfolio ↗
    </a>
</article>

<article class="project-card">
    <h2>GitHub Repositories</h2>

    <p>
        Explore my coding projects, source code,
        and development practice.
    </p>

    <a
        class="text-link"
        href="https://github.com/Appam23?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
    >
        Explore My GitHub Repositories ↗
    </a>
</article>

   
        </div>
    <section
            id="professional-work"
            class="featured-projects"
            aria-labelledby="featured-projects-title"
        >
        <h2 id="featured-projects-title">Featured Professional Work</h2>
        <img
            class="development-image"
            src="/web_design.png"
            alt="Illustration of website layouts on desktop, laptop, and mobile screens"
            loading="lazy"
        />
        <p>
            These real-world projects reflect my experience supporting live websites
            through design, content, and ongoing maintenance.
        </p>

        <div class="project-grid">
            <article class="featured-project">
                <h3>
                    <a
                        href="https://icongaming.us/"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        ICON Gaming Website
                    </a>
                </h3>
                <p><strong>Role:</strong> Web Design &amp; Development Intern</p>
                <p><strong>Platform:</strong> WordPress</p>
                <p>
                    Website updates, content editing, page design, layout improvements,
                    and maintenance.
                </p>
            </article>

            <article class="featured-project">
                <h3>
                    <a
                        href="https://radiohex.com/"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Radio Hex
                    </a>
                </h3>
                <p><strong>Role:</strong> Web Design &amp; Development Intern</p>
                <p><strong>Platform:</strong> WordPress</p>
                <p>Event management and website content updates.</p>
            </article>

            <article class="featured-project">
                <h3>
                    <a
                        href="https://scoremedicare.com/"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Score Medicare
                    </a>
                </h3>
                <p><strong>Role:</strong> Web Design &amp; Development Intern</p>
                <p><strong>Platform:</strong> WordPress</p>
                <p>Website content and page updates.</p>
            </article>
        </div>
    </section>

    <script src="/script.js" defer></script>
    </div>
</Layout>